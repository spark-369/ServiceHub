# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# `.env*` is git-ignored so secrets are never committed.
# ---------------------------------------------------------------------------

# Database (matches docker-compose.yml for local development)
DATABASE_URL="postgresql://postgres:mysecretpassword@localhost:5432/home_service_discovery?schema=public"
DIRECT_URL="postgresql://postgres:mysecretpassword@localhost:5432/home_service_discovery?schema=public"

# Redis (optional — real-time location + distributed rate limiting are disabled
# when this is unset and the app falls back to in-memory behaviour)
REDIS_URL="redis://localhost:6379"

# Authentication — MUST be at least 16 characters.
# Required in production; a development fallback is used otherwise.
JWT_SECRET="change-me-to-a-long-random-string"

# Stripe (optional — payments are disabled when these are unset)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Security / CORS / rate limiting (all optional)
ALLOWED_ORIGINS="http://localhost:3000"
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Logging (optional): debug | info | warn | error
LOG_LEVEL="debug"

# Dev-only diagnostics guard for /api/dev/test-env (optional)
DEBUG_API_KEY=""
